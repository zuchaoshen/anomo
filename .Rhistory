# File Name: 1.Illustration.R
# 1. MCCI----
set.seed(123)
library(anomo)
CI.1 <- mcci(d1 = 0.1, se1 = 0.01)
CI.1$out
CI.2 <- mcci(d1 = 0.1, se1 = 0.01, d2 = .15, se2 = .015)
CI.2$out
# 2. Power Analysis from Difference Perspectives----
# Calculate the required sample size to achieve certain level of power
mysample <- power.eq.2group(d = .05, eq.dis = 0.15,  p =.5,
r12 = .5, q = 1, power = .8)
mysample$out
# Calculate power provided by a sample size allocation
mypower <- power.eq.2group(d = .05, eq.dis = .15, n = 558, p =.5,
r12 = .5, q = 1)
mypower$out
# Calculate the minimum detectable distance a given sample size allocation can achieve
myeq.dis <- power.eq.2group(d = .05, n = 558, p =.5,
r12 = .5, q = 1, power = .8)
myeq.dis$out
# 3. Optimal Sample Allocation Identification
myod <- od.eq.2group(r12 = 0.5, c1 = 10, c1t = 100)
myod$out
balanced <- od.eq.2group(r12 = 0.5, c1 = 10, c1t = 100, p = .50)
# 4. Power Analysis Under the Optimal Allocation
mysample <- power.eq.2group(expr = myod, d = .05, eq.dis = 0.15,
q = 1, power = .8)
mysample$out
# 5. Relative Efficiency
RE <- re(myod, balanced)
RE$re
# 6. Power Curve
pwr <- NULL
# 6. Power Curve
pwr <- NULL
p.range <- seq(0.1, 0.9, 0.01)
for(p in p.range){
pwr <- c(pwr, power.eq.2group(expr = myod, constraint = list(p = p),
m = mysample$out$m, d = .05, eq.dis = 0.15,
q = 1))
}
#
max(pwr, na.rm = T)
min(pwr, na.rm = T)
mean(pwr, na.rm = T)
pwr
# 6. Power Curve
pwr <- NULL
p.range <- seq(0.1, 0.9, 0.01)
for(p in p.range){
pwr <- c(pwr, power.eq.2group(expr = myod, constraint = list(p = p),
m = mysample$out$m, d = .05, eq.dis = 0.15,
q = 1)$out$power)
}
#
max(pwr, na.rm = T)
min(pwr, na.rm = T)
mean(pwr, na.rm = T)
plot(p.range,
pwr,
type = "p", lty = 1,
xlim = c(0, 100), ylim = c(50, 200),
xlab = "Empirical TOST Power (%)", ylab = "Relative Power (%)",
main = "", col = "black")
plot(p.range*100,
pwr*100,
type = "p", lty = 1,
xlim = c(0, 100), ylim = c(0, 100),
xlab = "Proportion of Units in Treated (%)", ylab = "Power (%)",
main = "", col = "black")
abline(h=90, lty = 2, col = "black")
abline(h=110, lty = 2, col = "black")
abline(v=myod$out$p, lty = 2, col = "black")
abline(v=myod$out$p*100, lty = 2, col = "black")
# 6. Power Curve
pwr <- NULL
p.range <- seq(0.01, 0.99, 0.01)
for(p in p.range){
pwr <- c(pwr, power.eq.2group(expr = myod, constraint = list(p = p),
m = mysample$out$m, d = .05, eq.dis = 0.15,
q = 1)$out$power)
}
#
max(pwr, na.rm = T)
min(pwr, na.rm = T)
mean(pwr, na.rm = T)
plot(p.range*100,
pwr*100,
type = "p", lty = 1,
xlim = c(0, 100), ylim = c(0, 100),
xlab = "Proportion of Units in Treated (%)", ylab = "Power (%)",
main = "", col = "black")
abline(v=myod$out$p*100, lty = 2, col = "black")
plot(p.range*100,
pwr*100,
type = "p", lty = 2,
xlim = c(0, 100), ylim = c(0, 100),
xlab = "Proportion of Units in Treated (%)", ylab = "Power (%)",
main = "", col = "black")
plot(p.range*100,
pwr*100,
type = "l", lty = 1,
xlim = c(0, 100), ylim = c(0, 100),
xlab = "Proportion of Units in Treated (%)", ylab = "Power (%)",
main = "", col = "black")
abline(v=myod$out$p*100, lty = 2, col = "black")
mysample.balanced <- power.eq.2group(expr = balanced, d = .05, eq.dis = 0.15,
q = 1, power = .8)
mysample.balanced $out
